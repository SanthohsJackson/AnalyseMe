# Copy to .env and fill in the values for the provider you intend to use.
# .env is git-ignored and never committed.

# LLM provider: ollama (local, default) | openai | deepseek | openrouter | xai | groq | together
LLM_PROVIDER=ollama

# Ollama settings (local default)
OLLAMA_MODEL=gemma3:e4b
OLLAMA_BASE_URL=http://localhost:11434

# Hosted provider API keys — set the one matching LLM_PROVIDER
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

# Optional: override the model id (otherwise the provider default is used)
# MODEL_ID=
# OPENAI_BASE_URL=

# Embedding models for RAG chat
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector DB (pgvector) for RAG chat — matches docker-compose.yml
POSTGRES_CONN=postgresql+psycopg://cts:cts@localhost:5433/cts

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=code-to-spec
